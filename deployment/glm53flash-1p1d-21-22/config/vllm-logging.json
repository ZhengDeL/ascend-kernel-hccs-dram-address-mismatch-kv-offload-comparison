{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "diagnostic": {
      "class": "logging.Formatter",
      "format": "%(asctime)s %(levelname)s [pid=%(process)d thread=%(threadName)s] %(name)s %(filename)s:%(lineno)d %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "diagnostic",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {"handlers": ["console"], "level": "DEBUG", "propagate": false},
    "vllm_ascend": {"handlers": ["console"], "level": "DEBUG", "propagate": false},
    "uvicorn": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["console"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["console"], "level": "INFO"}
}
